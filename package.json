  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "country-flag-emoji-polyfill": "^0.1.10",
    "mp4-muxer": "^5.2.2",
    "qrcode-generator": "^2.0.4",
    "three": "^0.170.0"
